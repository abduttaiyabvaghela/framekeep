{
    "name": "framekeep/framekeep",
    "type": "project",
    "description": "Framekeep media library and mobile-ready API.",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-zip": "*",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "platform": { "php": "8.3.0" },
        "sort-packages": true,
        "optimize-autoloader": true,
        "prefer-dist": true
    }
}
